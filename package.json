{
  "name": "solid-euclid-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build solid_euclid --target web --out-dir ../pkg",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:cpp": "find examples/cpp \\( -name '*.cpp' -o -name '*.h' \\) ! -name 'doctest.h' | xargs clang-format --Wno-error=unknown -i",
    "test": "npm run build:wasm && vitest run",
    "test:watch": "npm run build:wasm && vitest",
    "test:cpp": "cmake --build build --target solid_euclid_tests && ./build/examples/cpp/solid_euclid_tests",
    "test:all": "cargo test && npm run test && npm run test:cpp",
    "ncu": "ncu -u && npm update && npm i && cd debug-apps && ncu -u && npm update && npm i",
    "tidy-up": "npm run format && npm run lint:fix && cargo fix --allow-dirty --allow-staged && cargo fmt && npm run format:cpp"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5"
  }
}
