{
  "name": "solid-euclid-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build solid_euclid --target web --out-dir ../pkg",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:cpp": "find examples/cpp -name '*.cpp' -o -name '*.h' | xargs clang-format -i",
    "test": "npm run build:wasm && vitest run",
    "test:watch": "npm run build:wasm && vitest",
    "test:cpp": "cmake --build build --target solid_euclid_tests && ./build/examples/cpp/solid_euclid_tests",
    "test:all": "cargo test && npm run test && npm run test:cpp",
    "ncu": "ncu -u && npm update && npm i && cd debug-apps && ncu -u && npm update && npm i",
    "tidy-up": "npm run format && npm run lint:fix && npm run format:cpp && cd solid_euclid && cargo fix --allow-dirty --allow-staged && cargo fmt"
  },
  "dependencies": {
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@types/three": "^0.182.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "npm-check-updates": "^19.3.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.16"
  }
}
